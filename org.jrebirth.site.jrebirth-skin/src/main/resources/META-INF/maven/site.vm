				</nav>
			</div>
		</header>
#end
       
        <div id="page">
#if ( !$jrLanding )
			<div class="jr-doc-shell">
#end
    	    $bodyContent
#if ( !$jrLanding )
			</div>
#end
		
		  	<div class="clear"></div>

#if ( !$jrLanding )
			<footer class="jr-footer">
				<div class="jr-wrap jr-footer-top">
