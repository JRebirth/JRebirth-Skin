## Modern site chrome for ALL pages; homepage keeps its own in-body header/footer
#set ( $jrLanding = false )
#if ( $currentFileName && ( $currentFileName.equals("index.html") || $currentFileName.equals("index") || $currentFileName.startsWith("index.") ) )
  #set ( $jrLanding = true )
#end
<html lang="en">
  <head>
    <meta charset="${outputEncoding}" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>$title</title>
    <link rel="stylesheet" href="$relativePath/css/landing.css" media="all" />
#if ( !$jrLanding )
    <link rel="stylesheet" href="$relativePath/css/site-docs.css" media="all" />
#end

## Manage Page Authors
    #foreach( $author in $authors )
    <meta name="author" content="$author" />
    #end
##    
## Manage Dates
#if ( $dateCreation )
    <meta name="Date-Creation-yyyymmdd" content="$dateCreation" />
#end
##
#if ( $dateRevision )
    <meta name="Date-Revision-yyyymmdd" content="$dateRevision" />
#end
## 
    #if ( $decoration.body.head )
      ## Doxia 2.x: head is a plain String (CDATA content), output directly
      $decoration.body.head
    #end
    #if( $headContent )$headContent#end
#if ( !$jrLanding )
    <script src="$relativePath/js/landing.js" defer="defer"></script>
#end
    #googleAnalytics( $decoration.googleAnalyticsAccountId )
  </head>

  <body class="jr-site#if ( $jrLanding ) jr-landing#else jr-docs#end">

	<div id="container">

#if ( !$jrLanding )
