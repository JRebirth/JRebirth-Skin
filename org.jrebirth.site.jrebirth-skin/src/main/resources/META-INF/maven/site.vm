#macro ( copyright )
  #if ( $project )
    #if ( $project.inceptionYear && $project.inceptionYear != $jrCurrentYear )
      ${project.inceptionYear}-${jrCurrentYear}
    #else
      ${jrCurrentYear}
    #end
##
    #if ( $project.organization && $project.organization.name )
      ${project.organization.name}
    #end
  #end
